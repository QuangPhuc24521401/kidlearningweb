rules_version = '2';

// Dán toàn bộ file này vào Firebase Console → Firestore → Rules → Publish
// (hoặc firebase deploy --only firestore:rules nếu đã cấu hình Firebase CLI)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function teacherClassRoom() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classRoom;
    }

    function studentInTeacherClass(userId) {
      return isTeacher()
        && get(/databases/$(database)/documents/users/$(userId)).data.classRoom == teacherClassRoom()
        && (
          get(/databases/$(database)/documents/users/$(userId)).data.role == 'parent'
          || !get(/databases/$(database)/documents/users/$(userId)).data.keys().hasAll(['role'])
        );
    }

    function sameClassAs(userId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classRoom
           == get(/databases/$(database)/documents/users/$(userId)).data.classRoom
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classRoom is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classRoom.size() >= 3;
    }

    function isFriendWith(userId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/friends/$(request.auth.uid)/list/$(userId));
    }

    function areFriends(uidA, uidB) {
      return exists(/databases/$(database)/documents/friends/$(uidA)/list/$(uidB))
        && exists(/databases/$(database)/documents/friends/$(uidB)/list/$(uidA));
    }

    function isListParticipant(parts) {
      return parts is list
        && parts.size() == 2
        && (
          request.auth.uid == parts[0]
          || request.auth.uid == parts[1]
        );
    }

    function isChatParticipant(chatId) {
      return isSignedIn()
        && isListParticipant(
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
    }

    // Hồ sơ user: chỉ chính chủ; giáo viên đọc phụ huynh cùng lớp;
    // mọi user đăng nhập có thể đọc hồ sơ giáo viên (để xác minh mã lớp).
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read: if resource.data.role == 'teacher'
        && resource.data.keys().hasAll(['classRoom'])
        && resource.data.classRoom is string
        && resource.data.classRoom.size() >= 3;
      allow read: if isTeacher()
        && resource.data.classRoom == teacherClassRoom()
        && (
          resource.data.role == 'parent'
          || !resource.data.keys().hasAll(['role'])
        );
      allow read: if isSignedIn()
        && resource.data.role == 'teacher'
        && resource.data.keys().hasAll(['classRoom'])
        && resource.data.classRoom is string
        && resource.data.classRoom.size() >= 3;
      allow read: if sameClassAs(userId);
      allow read: if isFriendWith(userId);
    }

    match /classrooms/{code} {
      allow get: if true;
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == request.resource.data.teacherUid
        && code == request.resource.data.classRoom
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.teacherUid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow update: if isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classRoom == code
        && request.resource.data.classRoom == resource.data.classRoom
        && request.resource.data.teacherUid == resource.data.teacherUid;
    }

    match /learning_progress/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read: if studentInTeacherClass(userId);
      allow read: if sameClassAs(userId);
    }

    match /arena_sessions/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /pvp_rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.hostId
        || request.auth.uid == resource.data.guestId
        || (
          resource.data.status == 'waiting'
          && resource.data.hostId != request.auth.uid
          && (
            !resource.data.keys().hasAll(['guestId'])
            || resource.data.guestId == null
          )
          && request.resource.data.guestId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId
        )
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.hostId
        || request.auth.uid == resource.data.guestId
      );
    }

    match /teacher_games/{gameId} {
      allow read: if isSignedIn() && (
        resource.data.published == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classRoom
           == resource.data.classRoom
      );
      allow read: if isTeacher()
        && request.auth.uid == resource.data.teacherUid;
      allow create: if isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.classRoom == teacherClassRoom();
      allow update, delete: if isTeacher()
        && request.auth.uid == resource.data.teacherUid;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.authorUid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeCount', 'commentCount'])
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
      }
    }

    match /follows/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      match /following/{targetId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == followerId;
      }
    }

    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.fromUid
        || request.auth.uid == resource.data.toUid
      );
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.toUid
        || request.auth.uid == resource.data.fromUid
      );
    }

    match /friends/{userId}/list/{friendUid} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && (
        request.auth.uid == userId
        || request.resource.data.friendUid == request.auth.uid
      );
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && isListParticipant(resource.data.participants);
      allow create: if isSignedIn()
        && isListParticipant(request.resource.data.participants)
        && areFriends(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        );
      allow update: if isSignedIn()
        && isListParticipant(resource.data.participants)
        && isListParticipant(request.resource.data.participants);

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
