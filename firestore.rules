rules_version = '2';

// Dán toàn bộ file này vào Firebase Console → Firestore → Rules → Publish
// (hoặc firebase deploy --only firestore:rules nếu đã cấu hình Firebase CLI)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function teacherClassRoom() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classRoom;
    }

    function studentInTeacherClass(userId) {
      return isTeacher()
        && get(/databases/$(database)/documents/users/$(userId)).data.classRoom == teacherClassRoom()
        && (
          get(/databases/$(database)/documents/users/$(userId)).data.role == 'parent'
          || !get(/databases/$(database)/documents/users/$(userId)).data.keys().hasAll(['role'])
        );
    }

    // Hồ sơ user: chỉ chính chủ; giáo viên đọc phụ huynh cùng lớp;
    // mọi user đăng nhập có thể đọc hồ sơ giáo viên (để xác minh mã lớp).
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      // Cho phép query giáo viên theo classRoom khi phụ huynh xác minh mã lớp lúc đăng ký (chưa đăng nhập)
      allow read: if resource.data.role == 'teacher'
        && resource.data.keys().hasAll(['classRoom'])
        && resource.data.classRoom is string
        && resource.data.classRoom.size() >= 3;
      allow read: if isTeacher()
        && resource.data.classRoom == teacherClassRoom()
        && (
          resource.data.role == 'parent'
          || !resource.data.keys().hasAll(['role'])
        );
      allow read: if isSignedIn()
        && resource.data.role == 'teacher'
        && resource.data.keys().hasAll(['classRoom'])
        && resource.data.classRoom is string
        && resource.data.classRoom.size() >= 3;
    }

    match /classrooms/{code} {
      // Tra cứu mã lớp khi đăng ký (chưa đăng nhập) — chỉ đọc 1 doc theo mã, không list cả collection
      allow get: if true;
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == request.resource.data.teacherUid
        && code == request.resource.data.classRoom
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.teacherUid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow update: if isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classRoom == code
        && request.resource.data.classRoom == resource.data.classRoom
        && request.resource.data.teacherUid == resource.data.teacherUid;
    }

    // Tiến độ học + huy hiệu + lịch sử Cô AI (doc id = uid)
    match /learning_progress/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      allow read: if studentInTeacherClass(userId);
    }

    // Đấu trường nhiều người (doc cố định live, hoặc mở rộng sau)
    match /arena_sessions/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // PvP — phòng 1v1
    match /pvp_rooms/{roomId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid;

      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.hostId
        || request.auth.uid == resource.data.guestId
        || (
          resource.data.status == 'waiting'
          && resource.data.hostId != request.auth.uid
          && (
            !resource.data.keys().hasAll(['guestId'])
            || resource.data.guestId == null
          )
          && request.resource.data.guestId == request.auth.uid
          && request.resource.data.hostId == resource.data.hostId
        )
      );

      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.hostId
        || request.auth.uid == resource.data.guestId
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
